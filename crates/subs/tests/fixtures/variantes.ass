[Script Info]
; Fixture del slice 2: Variantes que el fixture basico no toca. Cubre cursiva,
; negrita, ajuste automatico de linea, sombra, y un desvanecido (alfa parcial,
; que es donde se ve si la opacidad del color se aplica de verdad).
;
; ASCII a proposito, igual que basico.ass: aisla geometria, alfa y ajuste de
; cualquier problema de codificacion de texto.
ScriptType: v4.00+
PlayResX: 1920
PlayResY: 1080
WrapStyle: 0
ScaledBorderAndShadow: yes

[V4+ Styles]
Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding
; ASS usa AABBGGRR. Bold e Italic son -1 cuando estan activos.
Style: Cursiva,Arial,64,&H00FFFFFF,&H000000FF,&H00000000,&H80000000,0,-1,0,0,100,100,0,0,1,2,2,2,60,60,60,1
Style: Negrita,Arial,64,&H0000FFFF,&H00FFFFFF,&H00000000,&H80000000,-1,0,0,0,100,100,0,0,1,3,1,2,60,60,60,1
Style: Ancho,Arial,56,&H00FFD0D0,&H00FFFFFF,&H00202020,&H80000000,0,0,0,0,100,100,0,0,1,2,0,2,300,300,60,1

[Events]
Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text
Dialogue: 0,0:00:00.50,0:00:03.50,Cursiva,,0,0,0,,Cursiva con sombra
Dialogue: 0,0:00:00.50,0:00:03.50,Negrita,,0,0,0,,Negrita amarilla
Dialogue: 0,0:00:00.50,0:00:03.50,Ancho,,0,0,0,,Texto largo que tiene que partirse en dos lineas para tocar el ajuste automatico del estilo
